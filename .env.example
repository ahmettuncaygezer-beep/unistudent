# ÜniBütçe — Ortam değişkenleri örneği.
# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env git'e commit ETME.

APP_ENV=local
APP_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost/unistudent

# Veritabanı
DB_HOST=localhost
DB_NAME=unistudent
DB_USER=root
DB_PASS=

# Admin
ADMIN_USERNAME=admin
# Bcrypt hash; üretmek için: php -r "echo password_hash('sifre', PASSWORD_DEFAULT);"
ADMIN_PASSWORD_HASH=
ADMIN_MASTER_PIN=UNI-9999

# Güvenlik — benchmark hash'leme ve cookie consent anonimleştirme tuzu.
# Canlı ortamda mutlaka güçlü rastgele bir değer atayın!
# Örnek: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# Telegram Bot — BotFather'dan aldığınız token.
# Webhook: https://api.telegram.org/bot<TOKEN>/setWebhook?url=https://domain.com/api/telegram_webhook.php
TELEGRAM_BOT_TOKEN=

# API anahtarları
FAL_API_KEY=
OPENROUTER_API_KEY=

# CORS — virgülle ayrılmış origin listesi (boş = sadece same-origin)
CORS_ALLOWED_ORIGINS=
