{
  "builds": [
    { "src": "*.php",           "use": "vercel-php@0.7.2" },
    { "src": "api/*.php",       "use": "vercel-php@0.7.2" },
    { "src": "admin/*.php",     "use": "vercel-php@0.7.2" },
    { "src": "admin/api/*.php", "use": "vercel-php@0.7.2" },
    { "src": "tools/*.php",     "use": "vercel-php@0.7.2" },
    { "src": "blog/*.php",      "use": "vercel-php@0.7.2" },
    { "src": "assets/**",       "use": "@vercel/static" },
    { "src": "css/**",          "use": "@vercel/static" },
    { "src": "js/**",           "use": "@vercel/static" },
    { "src": "images/**",       "use": "@vercel/static" },
    { "src": "data/**",         "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/sitemap.xml",          "dest": "/sitemap.php" },
    { "src": "/assets/(.*)",          "dest": "/assets/$1" },
    { "src": "/css/(.*)",             "dest": "/css/$1" },
    { "src": "/js/(.*)",              "dest": "/js/$1" },
    { "src": "/images/(.*)",          "dest": "/images/$1" },
    { "src": "/data/(.*)",            "dest": "/data/$1" },
    { "src": "/blog/([^/.]+)$",       "dest": "/blog/$1.html" },
    { "src": "/tools/([^?]*\\.php.*)", "dest": "/tools/$1" },
    { "src": "/tools/(.*)",           "dest": "/tools/$1" },
    { "src": "/admin/(.*)",           "dest": "/admin/$1" },
    { "src": "/api/(.*)",             "dest": "/api/$1" },
    { "src": "/blog/(.*)",            "dest": "/blog/$1" },
    { "src": "/(.*)\\.php",           "dest": "/$1.php" },
    { "src": "/(.*)",                 "dest": "/index.php" }
  ]
}
